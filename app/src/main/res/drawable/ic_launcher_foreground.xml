<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：缺口朝下的仪表圆弧 + 车辆剪影，和 App 内的孪生仪表呼应。
  108dp 画布，图形落在中间 72dp 安全区内（半径 28 的弧 + 居中的车）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      两条弧共用一个圆：圆心 (54,54)、半径 28，从 150° 起顺时针扫 240°（缺口朝下），
      和 App 内 ArcGauge 的 START/SWEEP 一致。端点由 (54+28cosθ, 54+28sinθ) 算出：
        θ=150°  → (29.751, 68.000)   起点
        θ=318°  → (74.808, 35.264)   70% 处
        θ=390°  → (78.249, 68.000)   终点
      端点必须落在这个圆上。否则弦长一旦超过 2r，SVG 会把半径放大并把圆心挪到弦中点，
      两条弧就变成两个不同心的圆——之前亮弧用 (75.4,32.2) 正是栽在这里。
    -->

    <!-- 仪表底弧（暗） -->
    <path
        android:pathData="M29.751,68 A28,28 0 1 1 78.249,68"
        android:strokeColor="#4D35C7F2"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- 仪表进度弧（亮，走到 70%） -->
    <path
        android:pathData="M29.751,68 A28,28 0 0 1 74.808,35.264"
        android:strokeColor="#FF35C7F2"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- 车辆剪影 -->
    <group
        android:scaleX="1.65"
        android:scaleY="1.65"
        android:translateX="34.2"
        android:translateY="37.2">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M18.92,6.01C18.72,5.42 18.16,5 17.5,5h-11c-0.66,0 -1.21,0.42 -1.42,1.01L3,12v8c0,0.55 0.45,1 1,1h1c0.55,0 1,-0.45 1,-1v-1h12v1c0,0.55 0.45,1 1,1h1c0.55,0 1,-0.45 1,-1v-8l-2.08,-5.99zM6.5,16c-0.83,0 -1.5,-0.67 -1.5,-1.5S5.67,13 6.5,13s1.5,0.67 1.5,1.5S7.33,16 6.5,16zM17.5,16c-0.83,0 -1.5,-0.67 -1.5,-1.5s0.67,-1.5 1.5,-1.5 1.5,0.67 1.5,1.5 -0.67,1.5 -1.5,1.5zM5,11l1.5,-4.5h11L19,11L5,11z" />
    </group>
</vector>
